{
  "schema_version": 1,
  "plugins": [
    {
      "id": "payments",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.payments:PaymentsModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "settings": ["stripe_secret_key", "stripe_webhook_secret"],
      "financial_access": {"collections": ["orders", "payment_events"]},
      "roles": {
        "payments_finance": "create and inspect payment orders"
      },
      "permissions": {
        "utsu:payments:orders:manage": "Create and inspect payment orders."
      },
      "role_permissions": {
        "payments_finance": ["utsu:payments:orders:manage"]
      },
      "protection": {
        "orders": ["description", "checkout_url", "payment_intent"]
      },
      "order": 26
    },
    {
      "id": "profile",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.profile:ProfileModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "settings": ["max_cheque_bytes"],
      "financial_access": {"collections": ["financial_profiles"]},
      "protection": {
        "financial_profiles": ["institution_number", "transit_number", "account_number", "pending", "void_cheque"]
      },
      "json_protection": {
        "financial_profiles": ["pending", "void_cheque"]
      },
      "roles": {
        "profile_finance": "access and verify profile banking details"
      },
      "permissions": {
        "utsu:profile:financial:manage": "Access and verify profile banking details."
      },
      "role_permissions": {
        "profile_finance": ["utsu:profile:financial:manage"]
      },
      "order": 25
    },
    {
      "id": "sso",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.sso:SSOModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "settings": ["sso_issuer"],
      "order": 10
    },
    {
      "id": "auth",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.auth:AuthModule",
      "kind": "core",
      "auth_modes": ["local"],
      "protection": {
        "media": ["face", "id_card"],
        "roster_identifiers": ["digits"]
      },
      "settings": ["max_image_bytes", "division_codes"],
      "order": 20
    },
    {
      "id": "admin",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.admin:AdminModule",
      "kind": "core",
      "auth_modes": ["local"],
      "order": 90
    },
    {
      "id": "forms",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.forms:FormsModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "protection": {
        "submissions": ["data"]
      },
      "json_protection": {
        "submissions": ["data"]
      },
      "order": 70
    },
    {
      "id": "audit",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.audit:AuditModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "order": 110
    },
    {
      "id": "roles",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.roles:RolesModule",
      "kind": "core",
      "auth_modes": ["local"],
      "order": 120
    },
    {
      "id": "agm",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "agm.module:AgmModule",
      "kind": "program",
      "interface": "plugin",
      "dependencies": ["forms", "sso"],
      "form_ids": ["agm_rsvp"],
      "protection": {
        "agm_media": ["face", "id_card"]
      },
      "settings": ["agm_grant_ttl", "zoom_sso_url", "zoom_url"],
      "services": ["agm_review", "agm_sso", "audit", "auth", "forms", "identity", "now", "settings", "store"],
      "collections": ["agm_attendance", "agm_checks", "agm_grants", "agm_media"],
      "provides": ["agm_verification"],
      "roles": {
        "checkin": "AGM check-in and attendance",
        "agm_admin": "view AGM registrations and verify roster matches"
      },
      "permissions": {
        "utsu:agm:checkin:manage": "Manage AGM check-in and attendance.",
        "utsu:agm:registrations:manage": "View AGM registrations and verify roster matches."
      },
      "role_permissions": {
        "checkin": ["utsu:agm:checkin:manage"],
        "agm_admin": ["utsu:agm:registrations:manage"]
      },
      "order": 40
    },
    {
      "id": "agm_verify",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "agm.verify:AgmVerifyModule",
      "kind": "program",
      "interface": "plugin",
      "dependencies": ["agm"],
      "services": [
        "agm_image_limits", "agm_review", "audit", "auth", "files", "identity", "integrity", "now", "provided"
      ],
      "roles": {
        "agm_id_reviewer": "review AGM online ID scans and approve Zoom sign-on"
      },
      "permissions": {
        "utsu:agm:identity:review": "Review AGM online ID scans and approve Zoom sign-on."
      },
      "role_permissions": {
        "agm_id_reviewer": ["utsu:agm:identity:review"]
      },
      "order": 30
    },
    {
      "id": "senate",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "senate.module:SenateModule",
      "kind": "program",
      "interface": "plugin",
      "dependencies": ["forms"],
      "form_ids": ["senate_application"],
      "services": ["auth", "identity", "forms", "store", "audit", "now"],
      "collections": ["senate_config", "senate_published"],
      "roles": {
        "senate_admin": "view Senate applications"
      },
      "permissions": {
        "utsu:senate:applications:manage": "View and administer Senate applications."
      },
      "role_permissions": {
        "senate_admin": ["utsu:senate:applications:manage"]
      },
      "order": 50
    },
    {
      "id": "sap",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "sabp.module:SapModule",
      "kind": "program",
      "interface": "plugin",
      "dependencies": ["forms", "profile"],
      "form_ids": ["student_aid_bursary"],
      "settings": ["sap_review_enabled"],
      "financial_access": {
        "collections": ["sap_banking"],
        "submission_forms": ["student_aid_bursary"]
      },
      "protection": {
        "submissions": ["sap_review", "sap_review_hardship", "sap_previous"],
        "sap_banking": ["institution_number", "transit_number", "account_number", "pending", "void_cheque"]
      },
      "json_protection": {
        "submissions": ["sap_review", "sap_previous"],
        "sap_banking": ["pending", "void_cheque"]
      },
      "services": [
        "audit", "auth", "file_authorizers", "forms", "identity", "migrations",
        "now", "sap_banking", "settings", "store"
      ],
      "collections": ["sap_config"],
      "roles": {
        "sap_admin": "view student aid applications",
        "sap_finance": "student aid banking: flag details that fail validation, review void cheques",
        "sap_reviewer": "review student aid applications"
      },
      "permissions": {
        "utsu:sap:applications:manage": "View and administer student aid applications.",
        "utsu:sap:banking:manage": "Review and manage student aid banking details.",
        "utsu:sap:reviews:manage": "Review student aid applications."
      },
      "role_permissions": {
        "sap_admin": ["utsu:sap:applications:manage"],
        "sap_finance": ["utsu:sap:banking:manage"],
        "sap_reviewer": ["utsu:sap:reviews:manage"]
      },
      "order": 60
    },
    {
      "id": "clubs",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "clubs.module:ClubsModule",
      "kind": "program",
      "interface": "plugin",
      "financial_access": {"collections": ["transactions", "receipts"]},
      "protection": {
        "receipts": ["data_url"]
      },
      "settings": [
        "expense_approvals_small", "expense_approvals_large",
        "expense_large_cents", "default_tax_bps", "max_receipt_bytes"
      ],
      "services": [
        "audit", "auth", "club_invitation_link", "club_receipts", "email",
        "files", "identity", "now", "quotas", "settings", "store"
      ],
      "collections": ["clubs", "receipts", "transactions"],
      "quota_domains": ["club"],
      "roles": {
        "finance": "club transactions and grants",
        "clubs": "club registration decisions"
      },
      "permissions": {
        "utsu:clubs:finance:manage": "Manage club transactions and grants.",
        "utsu:clubs:applications:manage": "Review club registration applications."
      },
      "role_permissions": {
        "finance": ["utsu:clubs:finance:manage"],
        "clubs": ["utsu:clubs:applications:manage"]
      },
      "order": 100
    },
    {
      "id": "notices",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.notices:NoticesModule",
      "kind": "core",
      "order": 80
    },
    {
      "id": "messaging",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.messaging:MessagingModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "protection": {
        "messages": ["body"]
      },
      "order": 75
    },
    {
      "id": "content",
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "core.modules.content:ContentModule",
      "kind": "core",
      "auth_modes": ["local", "remote"],
      "order": 76
    },
    {
      "id": "discussion",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "chat.plugin:DiscussionPlugin",
      "kind": "program",
      "interface": "plugin",
      "default_enabled": false,
      "dependencies": ["messaging"],
      "services": ["audit", "auth", "messaging", "now", "store"],
      "collections": ["discussion_boards", "discussion_topics", "discussion_pagination_migrations"],
      "provides": ["discussion"],
      "roles": {
        "discussion_moderator": "moderate discussions: boards, locking, pinning and redaction"
      },
      "permissions": {
        "utsu:discussion:moderate": "Moderate discussion boards, topics, and messages."
      },
      "role_permissions": {
        "discussion_moderator": ["utsu:discussion:moderate"]
      },
      "order": 130
    },
    {
      "id": "voting",
      "frontend": true,
      "version": "0.1.0",
      "core_api_major": 1,
      "factory": "voting.plugin:VotingPlugin",
      "kind": "program",
      "interface": "plugin",
      "default_enabled": false,
      "dependencies": ["discussion"],
      "services": ["anchor", "audit", "auth", "integrity", "now", "provided", "store"],
      "collections": ["ballot_receipts", "ballot_votes", "ballots"],
      "unlinkable": ["ballot_votes"],
      "provides": ["voting"],
      "protection": {
        "ballot_votes": ["salt", "selection", "voter"]
      },
      "json_protection": {
        "ballot_votes": ["selection"]
      },
      "roles": {
        "elections_admin": "run ballots and polls, and break the seal on sealed ballots (every opening is logged)"
      },
      "permissions": {
        "utsu:voting:elections:manage": "Manage ballots, polls, and sealed-ballot unsealing."
      },
      "role_permissions": {
        "elections_admin": ["utsu:voting:elections:manage"]
      },
      "order": 140
    }
  ]
}
