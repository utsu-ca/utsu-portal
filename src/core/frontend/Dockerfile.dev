# Vite dev server. The repository's src/ and data/ are bind-mounted at /repo, so core and program-owned frontends are
# live. Dependencies sit at /node_modules so that every package under /repo/src resolves them by walking up.
FROM node:22-bookworm-slim
COPY src/core/frontend/package.json src/core/frontend/package-lock.json /
RUN cd / && npm ci && chown -R node:node /node_modules
ENV PATH=/node_modules/.bin:$PATH
USER node
WORKDIR /repo/src/core/frontend
CMD ["vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
