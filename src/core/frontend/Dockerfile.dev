FROM node:22-bookworm-slim
RUN install -d -o node -g node /app /data
WORKDIR /app
USER node
COPY --chown=node:node web/package.json web/package-lock.json ./
RUN npm ci
COPY --chown=node:node web/*.html web/vite.config.js ./
COPY --chown=node:node web/src ./src
COPY --chown=node:node data/wfni_weights.csv /data/wfni_weights.csv
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
